# Copy values into process-local environment variables before Docker Compose use.
# Do not commit an actual infra/.env file.
POSTGRES_DB=finguardops
POSTGRES_USER=finguardops
POSTGRES_PASSWORD=replace_with_local_only_password
GRAFANA_ADMIN_USER=replace_with_local_only_admin_id
GRAFANA_ADMIN_PASSWORD=replace_with_local_only_admin_password

# Issue #225 local JWT overlay uses fixed non-secret identifiers in Compose:
# issuer=https://local-jwt.fixture.finguardops.invalid
# jwk-set-uri=http://127.0.0.1:8002/oauth2/jwks
# Private keys and JWTs are ephemeral tmpfs/control-socket data and must never
# be added to this file. No local JWT secret or token environment variable exists.

# MANAGEMENT_SERVER_ADDRESS is intentionally not defined here.
# infra/compose.yml alone overrides it to 0.0.0.0 inside the Backend container;
# the application default remains 127.0.0.1.
