# Backend origin base URL. http or https scheme only.
# No username/password, no query string, no fragment.
VITE_API_BASE_URL=http://localhost:8080

# OIDC issuer (authority) of the Authorization Server. http or https only.
# Production builds accept https only; http is accepted outside production
# for loopback hosts only (localhost, 127.0.0.1, [::1]).
# No userinfo, no query string, no fragment, no surrounding whitespace.
# The value is used verbatim: a trailing slash is a meaningful issuer
# difference and is never added or removed by the application.
VITE_OIDC_AUTHORITY=http://localhost:8002

# Public SPA client ID. Used verbatim. There is no client secret: this is a
# public Authorization Code + PKCE client.
VITE_OIDC_CLIENT_ID=finguardops-frontend
