SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finguardops
SPRING_DATASOURCE_USERNAME=replace_me
SPRING_DATASOURCE_PASSWORD=replace_me
FINGUARDOPS_SECURITY_ISSUER=https://issuer.example.test/finguardops
FINGUARDOPS_SECURITY_JWK_SET_URI=https://issuer.example.test/.well-known/jwks.json
FINGUARDOPS_SECURITY_ALLOWED_ORIGINS=https://console.example.test
FINGUARDOPS_SECURITY_JWK_CONNECT_TIMEOUT=2s
FINGUARDOPS_SECURITY_JWK_READ_TIMEOUT=2s
FINGUARDOPS_EXTERNAL_RISK_HTTP_ENABLED=false
FINGUARDOPS_EXTERNAL_RISK_HTTP_BASE_URL=https://external-risk.example.test
FINGUARDOPS_EXTERNAL_RISK_HTTP_API_KEY=replace_me
FINGUARDOPS_EXTERNAL_RISK_HTTP_CONNECT_TIMEOUT=2s
FINGUARDOPS_EXTERNAL_RISK_HTTP_READ_TIMEOUT=3s
FINGUARDOPS_EXTERNAL_RISK_HTTP_MAX_RESPONSE_BYTES=65536
